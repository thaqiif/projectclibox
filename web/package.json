{
  "name": "clibox",
  "version": "1.0.0",
  "description": "Self-hosted web UI for managing persistent project terminals",
  "files": [
    "app/",
    "components/",
    "contexts/",
    "data/",
    "hooks/",
    "lib/",
    "public/",
    "styles/",
    "next.config.ts",
    "postcss.config.mjs",
    "server.ts",
    "tsconfig.json",
    "package-lock.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "prebuild": "node scripts/verify-wterm-ghostty-wasm.mjs",
    "build": "next build --webpack",
    "start": "NODE_ENV=production tsx server.ts",
    "test": "tsx --test components/Terminal/hooks/*.test.ts lib/*.test.ts lib/db/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package && node scripts/sync-wterm-ghostty-wasm.mjs && (chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true)"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaqiif/projectclibox.git"
  },
  "keywords": [
    "terminal",
    "tmux",
    "workspace",
    "projects"
  ],
  "author": "Muhammad Thaqif",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/thaqiif/projectclibox/issues"
  },
  "homepage": "https://github.com/thaqiif/projectclibox",
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@serwist/turbopack": "^9.5.7",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.16",
    "@uiw/react-codemirror": "^4.25.4",
    "@wterm/core": "0.5.0",
    "@wterm/dom": "0.5.0",
    "@wterm/ghostty": "0.5.0",
    "@wterm/react": "0.5.0",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.0",
    "lucide-react": "^0.556.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "node-pty": "^1.2.0-beta.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.3.0",
    "remark-gfm": "^4.0.1",
    "serwist": "^9.5.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.27",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.8",
    "patch-package": "8.0.1",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
