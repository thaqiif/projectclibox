# Local environment — copy .env.example to .env and edit.
# Never commit .env: it may hold API keys for the AI agents.
.env

# Local tooling / editor state
.claude/
node_modules/
**/node_modules/
**/.next/
**/.turbo/
workspaces/*
!workspaces/.gitkeep

# Agent session state
.omc/

# Crash dumps
core.*

# Rust build output (left by tools run inside web terminals)
target/
