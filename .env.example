# Host folder mounted into the container at /workspaces.
WORKSPACE_DIR=./workspaces

# Host folder mounted as /home/cliweb (persistent app data: settings, trash,
# installed tools). Per deployment: set a different absolute host path per
# Coolify app so production and test never share a home. Default is the
# host's /home/cliweb for single-deployment setups.
CLIWEB_HOME_DIR=/home/cliweb

# Host port and bind address for the web UI.
HOST_PORT=3011
HOST_BIND=127.0.0.1

# Match these to the owner of /home/cliweb and WORKSPACE_DIR (`id -u` / `id -g`).
PUID=1000
PGID=1000

# Optional environment variables (for example API keys) can be added here.
# The terminal inherits them when it is created.
#
# Optional: separate data from another CLIWeb deployment that shares this
# persisted home mount. With CLIWEB_PROFILE=test, this deployment keeps all
# its data in a single folder ~/.cliweb-test/ (database, trash, state), so it
# coexists with production's ~/.cliweb/ without sharing state with it.
# CLIWEB_PROFILE=test
