# Host folder persisted as the container's home (/home/clibox): shell config,
# tools installed from the terminal, and CLIBox's own database.
# Upgrading from CLIWeb? Point this at your old home, e.g. /home/cliweb.
CLIBOX_HOME_DIR=./data/home

# Host folder mounted into the container at /workspaces.
WORKSPACE_DIR=./workspaces

# Host port and bind address for the web UI.
HOST_PORT=3011
HOST_BIND=127.0.0.1

# Match these to the owner of CLIBOX_HOME_DIR and WORKSPACE_DIR (`id -u` / `id -g`).
PUID=1000
PGID=1000

# Optional environment variables (for example API keys) can be added here.
# The terminal inherits them when it is created.
#
# Optional: separate data from another CLIBox deployment that shares this
# persisted home mount. With CLIBOX_PROFILE=test, this deployment keeps all
# its data in a single folder ~/.clibox-test/ (database, trash, state), so it
# coexists with production's ~/.clibox/ without sharing state with it.
# CLIBOX_PROFILE=test
