# Host folder mounted into the container at /workspaces.
WORKSPACE_DIR=./workspaces

# Host port and bind address for the web UI.
HOST_PORT=3011
HOST_BIND=127.0.0.1

# Compose opts into tokenless trusted-proxy mode by default. Keep HOST_BIND
# localhost-only unless a Cloudflare Tunnel or another trusted edge is the
# only path to the service. Set this to false when using a token instead.
# PCLX_ALLOW_UNAUTHENTICATED_NON_LOOPBACK=true

# Optional shared token auth. Leave unset for trusted-proxy/edge-only mode.
# PROJECTCLIBOX_AUTH_TOKEN=replace-with-a-long-random-value

# Match these to the owner of /home/cliweb and WORKSPACE_DIR (`id -u` / `id -g`).
PUID=1000
PGID=1000

# Optional environment variables (for example API keys) can be added here.
# The terminal inherits them when it is created.
