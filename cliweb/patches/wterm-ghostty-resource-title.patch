+        writeU32(buf.ptr, 12, tx.size);
+        writeU32(buf.ptr, 16, tx.width);
+        writeU32(buf.ptr, 20, tx.height);
+        writeU32(buf.ptr, 24, @intCast(source.len));
+        @memcpy(buf[RESOURCE_REQUEST_HEADER_BYTES .. RESOURCE_REQUEST_HEADER_BYTES + source.len], source);
+        slot.request_taken = true;
+        return @intCast(RESOURCE_REQUEST_HEADER_BYTES + source.len);
+    }
