+/// 3=the WTerm URL extension.
+export fn read_resource_request(ptr: usize, buf_ptr: [*]u8, buf_len: u32) u32 {
+    const state = stateFromPtr(ptr);
+    const buf = buf_ptr[0..buf_len];
+    for (&state.resources.slots) |*slot| {
+        if (slot.id == 0 or slot.request_taken) continue;
+        const cmd = if (slot.command) |*value| value else continue;
+        const tx = kittyTransmission(cmd) orelse continue;
+        const source = cmd.data;
+        if (source.len > RESOURCE_MAX_PATH_BYTES or
+            buf.len < RESOURCE_REQUEST_HEADER_BYTES + source.len)
+        {
+            return 0;
